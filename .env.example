# Neon Postgres (Vercel Marketplace → Neon). Required at runtime for /api/desk.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth web client. Callback: https://keel-zeta-five.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google emails that may use Keel. Defaults to salle.kma@gmail.com.
ALLOWED_EMAILS=salle.kma@gmail.com

# Optional. Auth.js usually infers the host on Vercel.
# AUTH_URL=https://keel-zeta-five.vercel.app
# AUTH_TRUST_HOST=true
