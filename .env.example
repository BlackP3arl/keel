# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth web client.
# Production callback: https://keel.<your-workers-subdomain>.workers.dev/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google emails that may use Keel. Defaults to salle.kma@gmail.com.
ALLOWED_EMAILS=salle.kma@gmail.com

# Canonical site URL after the first deploy (workers.dev or a custom domain).
# AUTH_URL=https://keel.<your-workers-subdomain>.workers.dev
AUTH_TRUST_HOST=true

# Wrangler (deploy / remote D1) — set in the shell, not committed.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
